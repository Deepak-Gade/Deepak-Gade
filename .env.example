# Production deployment template. Copy backend values to server/.env.
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-bytes"
PORT=5000
FRONTEND_URL="https://app.example.com"
CORS_ORIGIN="https://app.example.com"
NODE_ENV=production

# Frontend build URL. Set it to the deployed API origin, including /api.
VITE_API_URL="https://api.example.com/api"

# Required only when running the production seed to create the first admin.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
